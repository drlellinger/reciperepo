# Docker Compose configuration
# Copy this file to .env and replace the example credentials.

ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

RECIPEREPO_PORT=8080
RECIPEREPO_SITE_NAME=reciperepo
RECIPEREPO_LOGO_TEXT=R
RECIPEREPO_LOGO_IMAGE=/assets/logo.svg
RECIPEREPO_LOGO_ALT=reciperepo
RECIPEREPO_FAVICON=/assets/favicon.ico
RECIPEREPO_APPLE_TOUCH_ICON=/assets/apple-touch-icon.png
RECIPEREPO_SITE_URL=
RECIPEREPO_FOOTER_NAME=[Github](https://github.com/drlellinger/reciperepo)
RECIPEREPO_PRIVACY_URL=
RECIPEREPO_IMPRINT_URL=
