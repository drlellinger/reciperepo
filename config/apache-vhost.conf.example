<VirtualHost *:443>
    ServerName recipes.example.org
    DocumentRoot /var/www/recipe-collection/public

    # Image and YAML uploads must be larger than the app-level limits.
    LimitRequestBody 16777216

    <Directory /var/www/recipe-collection/public>
        AllowOverride None
        Require all granted
        FallbackResource /index.php
    </Directory>

    ErrorDocument 401 /error/401
    ErrorDocument 403 /error/403
    ErrorDocument 500 /error/500

    <LocationMatch "^/admin(?:/|$)">
        AuthType Basic
        AuthName "Recipe administration"
        AuthUserFile /etc/recipe-collection/.htpasswd
        Require valid-user
    </LocationMatch>
</VirtualHost>

# PHP settings in php.ini or /etc/php/*/fpm/php.ini:
# upload_max_filesize = 16M
# post_max_size = 16M
# max_file_uploads = 20